# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL for callback links and deployed environments.
APP_URL="MY_APP_URL"

# Firebase Auth project used by the Vercel data API to verify Firebase ID tokens.
FIREBASE_PROJECT_ID="gen-lang-client-0065789810"

# Production: use the isolated Ditto PostgreSQL container via PgBouncer.
DATABASE_URL="postgresql://USER:PASSWORD@postgres.codehosted.com:6432/ditto?sslmode=verify-full"

# Optional Firebase user email with administrative access to Ditto data.
DITTO_ADMIN_EMAIL="bookdrakequantum@gmail.com"
